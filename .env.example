# --- satvox hub API (optional: OpenAI-compatible LLM endpoint) ---
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-3-llama-3.1-8b

# --- Hub bind address ---
HUB_BIND_IP=127.0.0.1
HUB_PORT=8000

# --- satvox ears (STT) ---
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- satvox mouth (TTS) ---
PIPER_VOICE=en_US-lessac-medium

# --- Honcho memory (self-hosted, optional) ---
HONCHO_URL=
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=satvox
HONCHO_USER_ID=appuser
HONCHO_ASSISTANT_ID=satvox
HONCHO_CONTEXT_TOKENS=4000

# --- Satellite (set per-Pi, not on the hub) ---
BRIDGE_URL=http://<your-hub-host>:18000/satellite/utterance
WAKE_MODEL=hey_jarvis
SATELLITE_ID=satellite-livingroom
